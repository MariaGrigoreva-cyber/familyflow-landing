# Генератор статей блога (npm run blog).
#
# Читается ТОЛЬКО серверным Node-скриптом scripts/generate-blog.js, который
# запускается вручную на вашей машине. Лендинг — статический, никакого
# бандлера здесь нет: ключ физически не может попасть в public/ или в браузер.
# Реальные значения храните в .env — он в .gitignore.

# Ключ OpenAI.
OPENAI_API_KEY=

# Модель для текста статьи и модель для иллюстраций.
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Домен блога — из него собираются canonical, og:image и sitemap.xml.
SITE_URL=https://myfamilyflow.ru

# Приложение: сюда ведут кнопки «Попробовать Семейный поток» из статей.
APP_URL=https://app.myfamilyflow.ru
